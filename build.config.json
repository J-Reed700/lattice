{
  "app": {
    "name": "Lattice Desktop",
    "identifier": "com.lattice.app",
    "version": "1.0.0"
  },
  "platforms": {
    "windows": {
      "enabled": true,
      "targets": ["x86_64-pc-windows-msvc"],
      "bundle": ["msi", "nsis"],
      "icon": "icons/icon.ico"
    },
    "macos": {
      "enabled": true,
      "targets": ["x86_64-apple-darwin", "aarch64-apple-darwin"],
      "bundle": ["dmg", "app"],
      "icon": "icons/icon.icns"
    },
    "linux": {
      "enabled": true,
      "targets": ["x86_64-unknown-linux-gnu"],
      "bundle": ["deb", "appimage"],
      "icon": "icons/icon.png"
    }
  },
  "features": {
    "embeddings": {
      "enabled": true,
      "description": "Enable ML embeddings and semantic search"
    },
    "file_watcher": {
      "enabled": true,
      "description": "Enable automatic file watching"
    },
    "sync": {
      "enabled": false,
      "description": "Enable cloud sync (experimental)"
    },
    "telemetry": {
      "enabled": false,
      "description": "Enable OpenTelemetry observability"
    }
  },
  "build": {
    "clean": false,
    "skipTests": false,
    "verbose": false,
    "parallel": true,
    "optimization": "release",
    "bundle": true,
    "checksums": true
  },
  "paths": {
    "dist": "dist",
    "logs": "build-logs",
    "cache": ".build-cache"
  }
}

