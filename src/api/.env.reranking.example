# ================================================================
# CROSS-ENCODER RERANKING CONFIGURATION
# ================================================================
# Add these to your main .env file to configure reranking
#
# Documentation: docs/RERANKING_GUIDE.md
# Quick Reference: docs/RERANKING_QUICK_REFERENCE.md
# ================================================================

# ================================================================
# BASIC SETTINGS
# ================================================================

# Enable or disable reranking globally
# Default: true
# Recommended: true (enables +10-15% precision improvement)
RERANKING_ENABLED=true

# Cross-encoder model to use
# Options:
#   - cross-encoder/ms-marco-MiniLM-L-6-v2  (fastest, English-only)
#   - BAAI/bge-reranker-base                (balanced)
#   - BAAI/bge-reranker-v2-m3               (best multilingual, RECOMMENDED)
#   - BAAI/bge-reranker-large               (most accurate, slowest)
# Default: BAAI/bge-reranker-v2-m3
RERANKING_MODEL=BAAI/bge-reranker-v2-m3

# ================================================================
# PIPELINE CONFIGURATION
# ================================================================

# Number of initial results to rerank
# Higher = more accurate but slower
# Range: 10-500
# Default: 100
# Recommended: 100 (good balance)
RERANKING_TOP_K_INPUT=100

# Number of reranked results to return
# Should be <= RERANKING_TOP_K_INPUT
# Range: 5-100
# Default: 50
# Recommended: 20-50
RERANKING_TOP_K_OUTPUT=50

# Maximum time for reranking (seconds)
# If exceeded, falls back to non-reranked results
# Range: 0.5-10.0
# Default: 2.0
# Recommended: 2.0 (balanced), 1.0 (speed), 5.0 (precision)
RERANKING_TIMEOUT=2.0

# ================================================================
# PERFORMANCE OPTIMIZATION
# ================================================================

# Batch size for cross-encoder inference
# Higher = faster but more memory
# Range: 8-128
# Default: 32
# Recommended:
#   - 8  (low memory, < 4GB RAM)
#   - 16 (medium memory, 4-8GB RAM)
#   - 32 (high memory, > 8GB RAM)
#   - 64 (GPU with large VRAM)
RERANKING_BATCH_SIZE=32

# Maximum characters to read from each document
# Lower = faster but less context
# Range: 500-10000
# Default: 2000
# Recommended: 2000 (good balance)
RERANKING_MAX_CONTENT_LENGTH=2000

# ================================================================
# CACHING
# ================================================================

# Enable result caching for repeated queries
# Provides ~10x speedup for cache hits
# Default: true
# Recommended: true (production), false (testing)
RERANKING_CACHE_ENABLED=true

# Cache time-to-live (seconds)
# How long to keep cached results
# Range: 60-86400 (1 minute to 1 day)
# Default: 3600 (1 hour)
# Recommended: 3600 (balanced freshness/performance)
RERANKING_CACHE_TTL=3600

# ================================================================
# CONFIGURATION PRESETS
# ================================================================

# ----------------------------------------------------------------
# PRESET 1: High Precision (Research, Legal, Medical)
# ----------------------------------------------------------------
# RERANKING_ENABLED=true
# RERANKING_MODEL=BAAI/bge-reranker-large
# RERANKING_TOP_K_INPUT=200
# RERANKING_TOP_K_OUTPUT=50
# RERANKING_TIMEOUT=5.0
# RERANKING_BATCH_SIZE=32
# RERANKING_CACHE_ENABLED=true
# RERANKING_CACHE_TTL=3600
# RERANKING_MAX_CONTENT_LENGTH=3000

# ----------------------------------------------------------------
# PRESET 2: Balanced (General Purpose) - RECOMMENDED
# ----------------------------------------------------------------
# RERANKING_ENABLED=true
# RERANKING_MODEL=BAAI/bge-reranker-v2-m3
# RERANKING_TOP_K_INPUT=100
# RERANKING_TOP_K_OUTPUT=20
# RERANKING_TIMEOUT=2.0
# RERANKING_BATCH_SIZE=32
# RERANKING_CACHE_ENABLED=true
# RERANKING_CACHE_TTL=3600
# RERANKING_MAX_CONTENT_LENGTH=2000

# ----------------------------------------------------------------
# PRESET 3: High Speed (Real-time Search)
# ----------------------------------------------------------------
# RERANKING_ENABLED=true
# RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKING_TOP_K_INPUT=50
# RERANKING_TOP_K_OUTPUT=10
# RERANKING_TIMEOUT=1.0
# RERANKING_BATCH_SIZE=32
# RERANKING_CACHE_ENABLED=true
# RERANKING_CACHE_TTL=3600
# RERANKING_MAX_CONTENT_LENGTH=1500

# ================================================================
# NOTES
# ================================================================
#
# MODEL COMPARISON:
# - ms-marco-MiniLM: ~60ms, English-only, good accuracy
# - bge-v2-m3:       ~120ms, multilingual, excellent accuracy
# - bge-large:       ~200ms, multilingual, excellent accuracy
#
# EXPECTED IMPROVEMENTS:
# - Precision: +10-15% nDCG@10 vs hybrid search
# - Cache speedup: ~10x for repeated queries
# - Memory: ~200-500MB for model
#
# WHEN TO USE:
# ✅ Semantic/ambiguous queries
# ✅ Precision-critical applications
# ✅ Long documents
# ✅ Knowledge bases
#
# WHEN NOT TO USE:
# ❌ Exact keyword matches
# ❌ Real-time requirements (< 50ms)
# ❌ File name lookups
# ❌ Limited resources
#
# MONITORING:
# - Check logs for reranking latency
# - Monitor cache hit rate
# - Track timeout rate
# - Watch memory usage
#
# TROUBLESHOOTING:
# - Too slow? Use ms-marco-MiniLM or reduce TOP_K_INPUT
# - Out of memory? Reduce BATCH_SIZE or TOP_K_INPUT
# - Timeout? Increase TIMEOUT or reduce TOP_K_INPUT
#
# ================================================================

