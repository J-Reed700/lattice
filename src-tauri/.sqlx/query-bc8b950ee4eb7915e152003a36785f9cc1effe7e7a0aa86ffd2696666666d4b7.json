  "query": "\n            SELECT t.id as \"id!\", t.name as \"name!\", t.color as \"color!\", t.created_at as \"created_at!\", t.updated_at as \"updated_at!\"\n            FROM tags t\n            INNER JOIN document_tags dt ON t.id = dt.tag_id\n            WHERE dt.document_id = ?\n            ORDER BY t.name ASC\n            ",
