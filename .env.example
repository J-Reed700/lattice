# Lattice environment variables (all optional).
# Copy to `.env` for the frontend values; Vite loads `.env` automatically.

# --- Frontend (read by Vite via import.meta.env, see src/utils/logger.ts) ---
# Enable frontend logging outside dev mode (logging is always on in `vite dev`).
# VITE_ENABLE_LOGGING=true
# Minimum frontend log level: debug | info | warn | error (default: debug).
# VITE_LOG_LEVEL=info

# --- Rust / Tauri (read from the process environment, NOT from .env; export them in your shell) ---
# Debug builds only: allow a llama-server sidecar that doesn't match scripts/llama-server.lock (release builds refuse it).
# LATTICE_ALLOW_UNPINNED_SIDECAR=1
# Force local ML inference onto the CPU instead of Metal/CUDA (accepts 1/true/yes/on).
# LATTICE_FORCE_CPU=1
