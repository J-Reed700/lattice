# ================================================================================
# Vault Backend Production Environment Configuration
# ================================================================================
# IMPORTANT: Copy this file to .env.prod and update all values with production credentials
# Never commit .env.prod to version control

# ================================================================================
# Application Settings
# ================================================================================
APP_NAME=Vault
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=json
STRUCTURED_LOGS=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://vault.yourdomain.com
WORKERS=4

# Security (MUST CHANGE IN PRODUCTION)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ================================================================================
# Database Configuration
# ================================================================================
# PostgreSQL credentials (CHANGE THESE)
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=vault

# Database URL
DATABASE_URL=postgresql://vault:CHANGE_THIS_TO_SECURE_PASSWORD@postgres:5432/vault

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=false

# ================================================================================
# Redis Configuration
# ================================================================================
# Redis password (CHANGE THIS)
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# Redis URL with password
REDIS_URL=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD@redis:6379/0
REDIS_MAX_CONNECTIONS=50
CACHE_TTL=3600

# ================================================================================
# ElectricSQL Configuration
# ================================================================================
# Electric password (CHANGE THIS)
ELECTRIC_PASSWORD=CHANGE_THIS_TO_SECURE_ELECTRIC_PASSWORD

ELECTRIC_URL=http://electric:5133
ELECTRIC_DATABASE_URL=postgresql://electric:CHANGE_THIS_TO_SECURE_ELECTRIC_PASSWORD@postgres:5432/electric

# ================================================================================
# MinIO/S3 Configuration
# ================================================================================
# MinIO credentials (CHANGE THESE)
MINIO_ACCESS_KEY=CHANGE_THIS_TO_SECURE_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_TO_SECURE_SECRET_KEY_MIN_8_CHARS

MINIO_ENDPOINT=minio:9000
MINIO_SECURE=true
MINIO_BUCKET=vault-files
MINIO_PUBLIC_ENDPOINT=https://storage.yourdomain.com
MINIO_CONSOLE_URL=https://storage-console.yourdomain.com

# ================================================================================
# File Processing
# ================================================================================
MAX_FILE_SIZE_MB=100
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.md,.jpg,.jpeg,.png,.gif,.mp4,.mov,.avi
TEMP_STORAGE_PATH=/data/tmp

# ================================================================================
# Machine Learning
# ================================================================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
IMAGE_EMBEDDING_DIMENSION=512

OCR_LANGUAGE=eng
ENABLE_OCR=true

ML_DEVICE=cpu
MODEL_CACHE_DIR=/app/models

# ================================================================================
# Celery Configuration
# ================================================================================
CELERY_BROKER_URL=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD@redis:6379/2
CELERY_WORKER_CONCURRENCY=8
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ================================================================================
# CORS Settings
# ================================================================================
CORS_ORIGINS=["https://vault.yourdomain.com","https://app.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true

# ================================================================================
# Monitoring and Security
# ================================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
ENABLE_RATE_LIMITING=true
RATE_LIMIT=100

# Sentry Error Tracking (CONFIGURE THESE)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ================================================================================
# Feature Flags
# ================================================================================
ENABLE_VECTOR_SEARCH=true
ENABLE_IMAGE_EMBEDDINGS=true
ENABLE_AUTO_SYNC=false
ENABLE_ELECTRIC_SYNC=true
ENABLE_VIDEO_PROCESSING=true
ENABLE_DOCS=false
AUTO_RELOAD=false

# ================================================================================
# Nginx Configuration
# ================================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ================================================================================
# Backup Configuration
# ================================================================================
# Optional: AWS S3 for backups
# BACKUP_S3_BUCKET=vault-backups
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_DEFAULT_REGION=us-east-1

# ================================================================================
# SSL/TLS Configuration
# ================================================================================
# Place SSL certificates in docker/ssl/
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ================================================================================
# IMPORTANT SECURITY NOTES
# ================================================================================
# 1. Change ALL passwords and secret keys above
# 2. Use strong, random passwords (min 32 characters)
# 3. Generate SECRET_KEY with: openssl rand -hex 32
# 4. Enable HTTPS in production (configure nginx.conf)
# 5. Configure firewall rules on your VPS
# 6. Set up regular database backups
# 7. Configure Sentry for error tracking
# 8. Review and adjust resource limits in docker-compose.prod.yml
# 9. Set up SSL certificates (Let's Encrypt recommended)
# 10. Never commit this file to version control
