//! Canonical Database Schema - Single Source of Truth
//! Issue #8: Fix Schema Fragmentation (P0 - Conflicts)

use crate::shared::error::{AppError, Result};
use sqlx::SqlitePool;

/// Database schema version
pub const SCHEMA_VERSION: i32 = 8;

/// Main schema initialization
pub async fn initialize_schema(pool: &SqlitePool) -> Result<()> {
    // Enable critical pragmas
    apply_pragmas(pool).await?;

    // Create all tables
    create_documents_table(pool).await?;
    create_text_chunks_table(pool).await?;
    create_embeddings_tables(pool).await?;
    create_metadata_tables(pool).await?;
    create_file_storage_tables(pool).await?;
    create_fts5_tables(pool).await?;
    create_favorites_table(pool).await?;
    create_recent_documents_table(pool).await?;
    create_conversation_tables(pool).await?;

    // Create all indexes
    create_indexes(pool).await?;

    // Create schema version tracking
    create_schema_version_table(pool).await?;

    // Run analyze to update statistics
    sqlx::query("ANALYZE").execute(pool).await?;

    Ok(())
}

async fn apply_pragmas(pool: &SqlitePool) -> Result<()> {
    // Critical pragmas for performance and integrity
    let pragmas = [
        "PRAGMA foreign_keys = ON",
        "PRAGMA journal_mode = WAL",
        "PRAGMA synchronous = NORMAL",
        "PRAGMA cache_size = -20000", // 20MB cache
        "PRAGMA temp_store = MEMORY",
        "PRAGMA mmap_size = 268435456", // 256MB memory map
    ];

    for pragma in &pragmas {
        sqlx::query(pragma).execute(pool).await?;
    }

    Ok(())
}

async fn create_documents_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS documents (
            id TEXT PRIMARY KEY,
            file_path TEXT NOT NULL UNIQUE,
            file_name TEXT NOT NULL,
            file_type TEXT,
            mime_type TEXT,
            size_bytes INTEGER NOT NULL,
            modified_at TEXT NOT NULL,
            indexed_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            checksum TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'pending',
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            source_type TEXT DEFAULT 'local' CHECK(source_type IN ('local', 'web')),
            canonical_url TEXT,
            site_name TEXT,
            favicon_url TEXT,
            reading_time_minutes INTEGER,
            web_author TEXT,
            published_at TEXT,
            web_description TEXT,
            web_keywords TEXT,
            web_language TEXT
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_text_chunks_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS text_chunks (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL,
            content TEXT NOT NULL,
            contextualized_content TEXT,
            context_prefix TEXT,
            chunk_index INTEGER NOT NULL,
            start_char INTEGER,
            end_char INTEGER,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_embeddings_tables(pool: &SqlitePool) -> Result<()> {
    // Text embeddings with BLOB storage for efficiency
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS text_embeddings (
            id TEXT PRIMARY KEY,
            chunk_id TEXT NOT NULL,
            embedding BLOB NOT NULL,
            model_name TEXT NOT NULL,
            dimension INTEGER NOT NULL,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (chunk_id) REFERENCES text_chunks(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Image embeddings
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS image_embeddings (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL,
            embedding BLOB NOT NULL,
            model_name TEXT NOT NULL,
            dimension INTEGER NOT NULL,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_metadata_tables(pool: &SqlitePool) -> Result<()> {
    // Image metadata
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS image_metadata (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL,
            width INTEGER,
            height INTEGER,
            format TEXT,
            has_exif BOOLEAN DEFAULT FALSE,
            exif_data TEXT,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Tags
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS tags (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL UNIQUE COLLATE NOCASE,
            color TEXT NOT NULL DEFAULT '#6366f1',
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Document tags junction
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS document_tags (
            document_id TEXT NOT NULL,
            tag_id TEXT NOT NULL,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            PRIMARY KEY (document_id, tag_id),
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE,
            FOREIGN KEY (tag_id) REFERENCES tags(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Mentions
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS mentions (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL UNIQUE,
            type TEXT NOT NULL CHECK(type IN ('person', 'concept', 'wikilink')),
            metadata TEXT,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Document mentions junction
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS document_mentions (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL,
            mention_id TEXT NOT NULL,
            context TEXT,
            position INTEGER,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE,
            FOREIGN KEY (mention_id) REFERENCES mentions(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Watch folders
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS watch_folders (
            id TEXT PRIMARY KEY,
            path TEXT NOT NULL UNIQUE,
            recursive BOOLEAN NOT NULL DEFAULT TRUE,
            enabled BOOLEAN NOT NULL DEFAULT TRUE,
            last_scan TEXT,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}
async fn create_file_storage_tables(pool: &SqlitePool) -> Result<()> {
    // Files table with content-addressable storage
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS files (
            id TEXT PRIMARY KEY NOT NULL,
            content_hash TEXT NOT NULL UNIQUE,
            file_name TEXT NOT NULL,
            file_extension TEXT,
            mime_type TEXT NOT NULL,
            size_bytes INTEGER NOT NULL,
            storage_path TEXT NOT NULL,
            is_indexed INTEGER NOT NULL DEFAULT 0,
            created_at INTEGER NOT NULL,
            accessed_at INTEGER NOT NULL,
            ref_count INTEGER NOT NULL DEFAULT 1 CHECK (ref_count >= 0),
            metadata TEXT
        )
        "#,
    )
    .execute(pool)
    .await?;

    // File references junction table
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS file_references (
            id TEXT PRIMARY KEY NOT NULL,
            file_id TEXT NOT NULL,
            document_id TEXT NOT NULL,
            reference_type TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            FOREIGN KEY (file_id) REFERENCES files(id) ON DELETE CASCADE,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE,
            UNIQUE(file_id, document_id, reference_type)
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}


async fn create_fts5_tables(pool: &SqlitePool) -> Result<()> {
    // Drop old FTS table if exists (to fix schema)
    sqlx::query("DROP TABLE IF EXISTS documents_fts")
        .execute(pool)
        .await?;

    // Create FTS5 virtual table for document-level search
    // One entry per document (aggregates all chunks)
    sqlx::query(
        r#"
        CREATE VIRTUAL TABLE documents_fts USING fts5(
            document_id UNINDEXED,
            content,
            tokenize='porter unicode61 remove_diacritics 2'
        )
        "#,
    )
    .execute(pool)
    .await
    .map_err(|e| AppError::Database(format!("Failed to create FTS5 table: {}", e)))?;

    // Drop old triggers
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_ai")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_ai_update")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_ad")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_au")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_fts_insert")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_fts_delete")
        .execute(pool)
        .await?;
    sqlx::query("DROP TRIGGER IF EXISTS text_chunks_fts_update")
        .execute(pool)
        .await?;

    // Create triggers to aggregate chunks into document-level FTS5 entries
    // After chunk insert: rebuild FTS5 entry for document
    sqlx::query(
        r#"
        CREATE TRIGGER text_chunks_fts_insert
        AFTER INSERT ON text_chunks
        BEGIN
            DELETE FROM documents_fts WHERE document_id = new.document_id;
            INSERT INTO documents_fts(document_id, content)
            SELECT new.document_id, GROUP_CONCAT(content, ' ')
            FROM text_chunks
            WHERE document_id = new.document_id
            GROUP BY document_id;
        END
        "#,
    )
    .execute(pool)
    .await?;

    // After chunk delete: rebuild FTS5 entry for document
    sqlx::query(
        r#"
        CREATE TRIGGER text_chunks_fts_delete
        AFTER DELETE ON text_chunks
        BEGIN
            DELETE FROM documents_fts WHERE document_id = old.document_id;
            INSERT INTO documents_fts(document_id, content)
            SELECT old.document_id, GROUP_CONCAT(content, ' ')
            FROM text_chunks
            WHERE document_id = old.document_id
            GROUP BY document_id;
        END
        "#,
    )
    .execute(pool)
    .await?;

    // After chunk update: rebuild FTS5 entry for document
    sqlx::query(
        r#"
        CREATE TRIGGER text_chunks_fts_update
        AFTER UPDATE OF content ON text_chunks
        BEGIN
            DELETE FROM documents_fts WHERE document_id = new.document_id;
            INSERT INTO documents_fts(document_id, content)
            SELECT new.document_id, GROUP_CONCAT(content, ' ')
            FROM text_chunks
            WHERE document_id = new.document_id
            GROUP BY document_id;
        END
        "#,
    )
    .execute(pool)
    .await?;

    // Populate FTS5 with existing data
    rebuild_fts5_index(pool).await?;

    Ok(())
}

/// Rebuild FTS5 index from existing chunks
pub async fn rebuild_fts5_index(pool: &SqlitePool) -> Result<()> {
    // Clear FTS5 table
    sqlx::query("DELETE FROM documents_fts")
        .execute(pool)
        .await?;

    // Populate with aggregated chunks per document
    sqlx::query(
        r#"
        INSERT INTO documents_fts(document_id, content)
        SELECT document_id, GROUP_CONCAT(content, ' ')
        FROM text_chunks
        GROUP BY document_id
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_indexes(pool: &SqlitePool) -> Result<()> {
    // Most critical - used in every chunk search
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_chunks_document ON text_chunks(document_id)")
        .execute(pool)
        .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_chunks_composite ON text_chunks(document_id, chunk_index)",
    )
    .execute(pool)
    .await?;

    // For document lookups by path and filename
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_file_path ON documents(file_path)")
        .execute(pool)
        .await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_filename ON documents(file_name)")
        .execute(pool)
        .await?;

    // For status filtering
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_status ON documents(status)")
        .execute(pool)
        .await?;

    // For embedding lookups
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_embeddings_chunk ON text_embeddings(chunk_id)")
        .execute(pool)
        .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_image_embeddings_document ON image_embeddings(document_id)",
    )
    .execute(pool)
    .await?;

    // For watch folder lookups
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_watch_folders_path ON watch_folders(path)")
        .execute(pool)
        .await?;

    // Additional useful indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_checksum ON documents(checksum)")
        .execute(pool)
        .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_chunks_content_length ON text_chunks(length(content))",
    )
    .execute(pool)
    .await?;

    // Tag indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_tags_name ON tags(name)")
        .execute(pool)
        .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_document_tags_document_id ON document_tags(document_id)",
    )
    .execute(pool)
    .await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_document_tags_tag_id ON document_tags(tag_id)")
        .execute(pool)
        .await?;

    // Mention indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_mentions_name ON mentions(name)")
        .execute(pool)
        .await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_mentions_type ON mentions(type)")
        .execute(pool)
        .await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_document_mentions_document_id ON document_mentions(document_id)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_document_mentions_mention_id ON document_mentions(mention_id)")
        .execute(pool).await?;

    // ===== COMPOSITE INDEXES FOR IMPROVED QUERY PERFORMANCE =====

    // Composite index for document_tags (most frequently queried)
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_document_tags_composite
         ON document_tags(document_id, tag_id)",
    )
    .execute(pool)
    .await?;

    // Index for case-insensitive tag searches
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_tags_name_lower
         ON tags(LOWER(name))",
    )
    .execute(pool)
    .await?;

    // Composite index for document_mentions (improves mention query performance)
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_document_mentions_composite
         ON document_mentions(document_id, mention_id)",
    )
    .execute(pool)
    .await?;

    // Index for mention type filtering (faster "show all people" queries)
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_mentions_type_name
         ON mentions(type, name)",
    )
    .execute(pool)
    .await?;

    // Composite index for updated_at DESC queries (recent documents)
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_documents_updated_desc
         ON documents(updated_at DESC)",
    )
    .execute(pool)
    .await?;

    // Composite index for status + updated_at (filtered recent queries)
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_documents_status_updated
         ON documents(status, updated_at DESC)",
    )
    .execute(pool)
    .await?;

    // Composite index for text_embeddings lookups
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_embeddings_chunk_model
         ON text_embeddings(chunk_id, model_name)",
    )
    .execute(pool)
    .await?;

    // ===== AUDIT-IDENTIFIED PERFORMANCE INDEXES =====

    // Index for recent document queries by indexed_at
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_documents_indexed
         ON documents(indexed_at DESC)",
    )
    .execute(pool)
    .await?;

    // Composite index for chunk ordering and retrieval
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_chunks_start_char
         ON text_chunks(document_id, start_char)",
    )
    .execute(pool)
    .await?;

    // Favorites indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_favorites_document_id ON favorites(document_id)")
        .execute(pool)
        .await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_favorites_added_at ON favorites(added_at DESC)")
        .execute(pool)
        .await?;

    // Recent documents indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_recent_documents_document_id ON recent_documents(document_id)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_recent_documents_last_accessed ON recent_documents(last_accessed_at DESC)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_recent_documents_access_count ON recent_documents(access_count DESC)")
        .execute(pool).await?;


    // File storage indexes
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_files_hash ON files(content_hash)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_files_mime ON files(mime_type)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_files_accessed ON files(accessed_at)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_files_extension ON files(file_extension)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_file_refs_file ON file_references(file_id)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_file_refs_doc ON file_references(document_id)")
        .execute(pool).await?;

    // Web document indexes (v3)
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_source_type ON documents(source_type)")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_canonical_url ON documents(canonical_url) WHERE canonical_url IS NOT NULL")
        .execute(pool).await?;

    sqlx::query("CREATE INDEX IF NOT EXISTS idx_documents_web ON documents(source_type, indexed_at DESC) WHERE source_type = 'web'")
        .execute(pool).await?;

    Ok(())
}

async fn create_favorites_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS favorites (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL UNIQUE,
            added_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_recent_documents_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS recent_documents (
            id TEXT PRIMARY KEY,
            document_id TEXT NOT NULL UNIQUE,
            last_accessed_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            access_count INTEGER NOT NULL DEFAULT 1,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}


async fn create_daily_notes_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS daily_notes (
            id TEXT PRIMARY KEY NOT NULL,
            title TEXT NOT NULL,
            content TEXT NOT NULL DEFAULT '',
            file_path TEXT NOT NULL,
            date TEXT NOT NULL UNIQUE,
            created_at TEXT NOT NULL,
            modified_at TEXT NOT NULL
        ) STRICT
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}
async fn create_conversation_tables(pool: &SqlitePool) -> Result<()> {
    // Conversations table: stores conversation metadata
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS conversations (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            model_name TEXT NOT NULL,
            system_prompt TEXT,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            message_count INTEGER NOT NULL DEFAULT 0,
            total_tokens INTEGER NOT NULL DEFAULT 0
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Conversation messages table: stores individual messages in a conversation
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS conversation_messages (
            id TEXT PRIMARY KEY,
            conversation_id TEXT NOT NULL,
            role TEXT NOT NULL CHECK(role IN ('user', 'assistant', 'system')),
            content TEXT NOT NULL,
            tokens INTEGER NOT NULL DEFAULT 0,
            created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            metadata TEXT,
            FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Conversation documents: tracks which documents are in the conversation context
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS conversation_documents (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            conversation_id TEXT NOT NULL,
            document_id TEXT NOT NULL,
            chunk_id TEXT,
            relevance_score REAL,
            added_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (conversation_id) REFERENCES conversations(id) ON DELETE CASCADE,
            FOREIGN KEY (document_id) REFERENCES documents(id) ON DELETE CASCADE,
            UNIQUE(conversation_id, chunk_id)
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Indexes for performance
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_conversation_messages_conversation_id
         ON conversation_messages(conversation_id, created_at)",
    )
    .execute(pool)
    .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_conversation_messages_role
         ON conversation_messages(role)",
    )
    .execute(pool)
    .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_conversations_updated_at
         ON conversations(updated_at DESC)",
    )
    .execute(pool)
    .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_conversation_documents_conversation_id
         ON conversation_documents(conversation_id)",
    )
    .execute(pool)
    .await?;

    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_conversation_documents_document_id
         ON conversation_documents(document_id)",
    )
    .execute(pool)
    .await?;

    Ok(())
}

async fn create_schema_version_table(pool: &SqlitePool) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS schema_version (
            version INTEGER PRIMARY KEY,
            applied_at INTEGER NOT NULL DEFAULT (unixepoch()),
            description TEXT
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Insert current version
    sqlx::query(
        r#"
        INSERT OR REPLACE INTO schema_version (version, description)
        VALUES (?, 'Add conversation support for LLM interactions')
        "#,
    )
    .bind(SCHEMA_VERSION)
    .execute(pool)
    .await?;

    Ok(())
}
