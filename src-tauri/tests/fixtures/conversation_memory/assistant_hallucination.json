{
  "family": "assistant_hallucination",
  "capability": "A repeated incorrect assistant claim never overwrites the user's original evidence.",
  "mode": "standard",
  "decoy_quote": null,
  "turns": [
    {
      "role": "user",
      "content": "The cutover window is Saturday 07:00 to 09:00 UTC. Two hours, no more."
    },
    {
      "role": "assistant",
      "content": "Noted: Saturday 07:00 to 09:00 UTC."
    },
    {
      "role": "user",
      "content": "Plan the cutover steps inside that window."
    },
    {
      "role": "assistant",
      "content": "Here is a plan for the four-hour window from 07:00 to 11:00 UTC."
    },
    {
      "role": "user",
      "content": "Continue with the rollback plan."
    },
    {
      "role": "assistant",
      "content": "Rollback fits comfortably in the four-hour window ending 11:00 UTC."
    },
    {
      "role": "user",
      "content": "What about the comms plan?"
    },
    {
      "role": "assistant",
      "content": "Comms go out at 06:30 and again at the close of the four-hour window, 11:00 UTC."
    },
    {
      "role": "user",
      "content": "Add the DNS step."
    },
    {
      "role": "assistant",
      "content": "DNS change at 08:00, well inside the four-hour window."
    }
  ],
  "filler_turns": [
    {
      "role": "user",
      "content": "Separately, remind me what a p95 latency figure actually measures."
    },
    {
      "role": "assistant",
      "content": "It is the value below which 95 percent of observations fall."
    }
  ],
  "expect": {
    "min_mandatory_items": 1,
    "required_active_quotes": [
      "Saturday 07:00 to 09:00 UTC"
    ],
    "superseded_quotes": [],
    "must_not_be_authoritative": [
      "four-hour window from 07:00 to 11:00 UTC"
    ],
    "expect_unresolved_conflict": false,
    "expect_overflow": false,
    "forbidden_tools": [],
    "allowed_tools": [
      "read_note"
    ],
    "questions": [
      {
        "ask": "How long is the cutover window, and when does it end?",
        "must_quote": [
          "09:00"
        ],
        "must_not_contain": [
          "ends at 11:00",
          "window is four hours"
        ],
        "abstain": false
      }
    ],
    "abstain_markers": [
      "cannot",
      "can't",
      "no record",
      "not stated",
      "do not have",
      "don't have",
      "unable",
      "nothing in",
      "was not",
      "wasn't",
      "unclear"
    ]
  },
  "cycles": [
    1,
    3,
    10
  ],
  "reload_after_cycles": [
    1,
    3
  ]
}
