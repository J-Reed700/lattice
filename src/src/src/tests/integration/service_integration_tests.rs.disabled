/// Test: File Storage with Invalid Path
///
/// Verifies file storage handles invalid paths gracefully:
/// 1. Attempt to create ValidatedFilePath with traversal
/// 2. Verify error is returned
#[tokio::test]
async fn test_file_storage_invalid_path() -> anyhow::Result<()> {
    // Arrange: Setup isolated environment
    let pool = create_test_pool_with_uuid().await;
    let temp_dir = TempDir::new()?;
    let vault_path = temp_dir.path().to_path_buf();

    let _file_storage = Arc::new(FileStorageService::new(vault_path.clone(), pool.clone()));

    // Act: Attempt to create validated path with directory traversal
    let malicious_path = PathBuf::from("../../etc/passwd");
    let result = ValidatedFilePath::new(malicious_path);

    // Assert: Should fail validation
    assert!(
        result.is_err(),
        "Should reject path with directory traversal"
    );

    Ok(())
}

/// Test: Concurrent Tag Creation
///
/// Verifies tag service handles concurrent operations correctly:
/// 1. Create multiple tags concurrently
/// 2. Verify all tags are created without conflicts
/// 3. Verify database isolation
#[tokio::test]
async fn test_concurrent_tag_creation() -> anyhow::Result<()> {
    // Arrange: Setup isolated environment
    let pool = create_test_pool_with_uuid().await;
    let tag_service = Arc::new(TagServiceImpl::new(pool.clone()));

    // Act: Create tags concurrently
    let tag_names = vec!["Tag1", "Tag2", "Tag3", "Tag4", "Tag5"];

    let mut handles = vec![];
    for name in tag_names.iter() {
        let service = Arc::clone(&tag_service);
        let name_owned = name.to_string();

        let handle = tokio::spawn(async move {
            service.create_tag(&name_owned, None).await
        });

        handles.push(handle);
    }

    // Wait for all creations
    let mut created_ids = vec![];
    for handle in handles {
        let tag_id = handle.await??;
        created_ids.push(tag_id);
    }

    // Assert: All tags should be created
    assert_eq!(
        created_ids.len(),
        5,
        "Should create all 5 tags"
    );

    // Verify all IDs are unique
    let unique_tag_ids: std::collections::HashSet<_> = created_ids.iter().map(|t| t.id()).collect();
    assert_eq!(
        unique_tag_ids.len(),
        created_ids.len(),
        "All tags should be unique (no duplicates)"
    );

    // Verify all tags exist in database
    let all_tags = tag_service.get_all_tags().await?;
    assert_eq!(
        all_tags.len(),
        5,
        "Database should contain all 5 tags"
    );

    Ok(())
}

/// Test: Resource Cleanup Across Services
///
/// Verifies cleanup operations work correctly:
/// 1. Create conversation
/// 2. Create tags
/// 3. Delete conversation
/// 4. Verify tags can still be used with other conversations
#[tokio::test]
async fn test_resource_cleanup_conversation_tags() -> anyhow::Result<()> {
    // Arrange: Setup isolated environment
    let pool = create_test_pool_with_uuid().await;

    let conversation_service = ConversationService::new(pool.clone());
    let tag_service = Arc::new(TagServiceImpl::new(pool.clone()));

    // Create conversation and tags
    let conv_1 = conversation_service
        .create_conversation("Conv 1".to_string(), "gpt-4".to_string(), None)
        .await?;

    let _tag = tag_service.create_tag("SharedTag", None).await?;

    // Create second conversation
    let conv_2 = conversation_service
        .create_conversation("Conv 2".to_string(), "gpt-4".to_string(), None)
        .await?;

    // Act: Delete first conversation
    conversation_service.delete_conversation(conv_1.id.as_str()).await?;

    // Assert: Tag should still exist
    let tags = tag_service.get_all_tags().await?;
    assert_eq!(
        tags.len(),
        1,
        "Tag should still exist after conversation deletion"
    );
    assert_eq!(
        tags[0].name().as_ref(),
        "SharedTag",
        "Tag name should be preserved"
    );

    // Second conversation should still exist
    let retrieved_conv_2 = conversation_service.get_conversation(conv_2.id.as_str()).await?;
    assert!(
        retrieved_conv_2.is_some(),
        "Second conversation should still exist"
    );

    Ok(())
}

