//! Integration Tests for Service Interactions
//!
//! Tests multi-service workflows to verify services work together correctly.
//! Uses UUID-based database isolation and tempfile for filesystem isolation.
//!
//! **IMPORTANT**: These tests verify ACTUAL service interactions in the codebase.
//! Uses mock services where real dependencies (like ONNX models) are unavailable.

use crate::features::conversation::service::ConversationService;
use crate::infrastructure::services::file_storage::FileStorageService;
use crate::infrastructure::services::tag_service_impl::TagServiceImpl;
use crate::infrastructure::services::traits::{EmbeddingServiceTrait, SearchServiceTrait, TagServiceTrait};
use crate::infrastructure::services::mocks::{MockEmbeddingService, MockSearchService};
use crate::tests::common::test_utils::create_test_pool_with_uuid;
use std::sync::Arc;
use tempfile::TempDir;
use std::path::PathBuf;
use crate::shared::domain_types::ValidatedFilePath;

// ============================================================================
// P0 Integration Tests: Core Workflows
// ============================================================================

/// Test: FileStorageService Basic Operations
///
/// Verifies file storage core functionality:
/// 1. Store file
/// 2. Retrieve file
/// 3. Verify metadata
#[tokio::test]
async fn test_file_storage_basic_operations() -> anyhow::Result<()> {
    // Arrange: Setup isolated environment
    let pool = create_test_pool_with_uuid().await;
    let temp_dir = TempDir::new()?;
    let vault_path = temp_dir.path().to_path_buf();

    // Create test file
    let test_file_path = vault_path.join("test_document.txt");
    std::fs::write(&test_file_path, "This is a test document for file storage.")?;

    // Setup service
    let file_storage = Arc::new(FileStorageService::new(vault_path.clone(), pool.clone()));

    // Act: Store file with validated path
    let validated_path = ValidatedFilePath::new(test_file_path.clone())?;
    let file_record = file_storage
        .store_file(
            validated_path,
            "text/plain",
            None,
        )
        .await?;

    // Assert: Verify file record created
    assert!(
        !file_record.id.is_empty(),
        "File ID should be generated"
    );
    assert_eq!(
        file_record.mime_type,
        "text/plain",
        "MIME type should match"
    );
    assert_eq!(
        file_record.size_bytes,
        42,
        "File size should match content length"
    );

    // Verify we can retrieve the file
    let retrieved = file_storage.get_file_by_id(&file_record.id).await?;
    assert!(
        retrieved.is_some(),
        "Should retrieve stored file"
    );

    let retrieved_record = retrieved.unwrap();
    assert_eq!(
        retrieved_record.id,
        file_record.id,
        "Retrieved file ID should match"
    );

    Ok(())
}

/// Test: Embedding + Search Integration (with Mocks)
///
/// Verifies embedding generation and search work together:
/// 1. Generate embeddings for documents
/// 2. Configure search service
/// 3. Perform search and verify results
#[tokio::test]
async fn test_embedding_search_integration() -> anyhow::Result<()> {
    // Arrange: Setup services with mocks
    let embedding_service = Arc::new(MockEmbeddingService::new(384)) as Arc<dyn EmbeddingServiceTrait>;
    let search_service = Arc::new(MockSearchService::new()) as Arc<dyn SearchServiceTrait>;

    // Create test documents
    let doc1 = "Machine learning is a subset of artificial intelligence.";
    let doc2 = "Rust is a systems programming language focused on safety.";
    let doc3 = "Deep learning uses neural networks with multiple layers.";

    // Act: Generate embeddings
    let embedding1 = embedding_service.embed_single(doc1).await?;
    let embedding2 = embedding_service.embed_single(doc2).await?;
    let embedding3 = embedding_service.embed_single(doc3).await?;

    // Assert: Verify embeddings have correct dimensions
    assert_eq!(
        embedding1.len(),
        384,
        "Embedding should have 384 dimensions"
    );
    assert_eq!(
        embedding2.len(),
        384,
        "Embedding should have 384 dimensions"
    );
    assert_eq!(
        embedding3.len(),
        384,
        "Embedding should have 384 dimensions"
    );

    // Verify embeddings are distinct (not all zeros)
    let sum1: f32 = embedding1.iter().sum();
    let sum2: f32 = embedding2.iter().sum();

    assert!(
        sum1.abs() > 0.0,
        "Embedding should not be all zeros"
    );
    assert!(
        sum2.abs() > 0.0,
        "Embedding should not be all zeros"
    );

    Ok(())
}

/// Test: Conversation + Tag Integration
///
/// Verifies conversation and tag services work together:
/// 1. Create conversation
/// 2. Create tags
/// 3. Verify both services maintain state independently
#[tokio::test]
async fn test_conversation_tag_integration() -> anyhow::Result<()> {
    // Arrange: Setup isolated environment
    let pool = create_test_pool_with_uuid().await;

    let conversation_service = ConversationService::new(pool.clone());
    let tag_service = Arc::new(TagServiceImpl::new(pool.clone()));

    // Act: Create a conversation
    let conversation = conversation_service
        .create_conversation(
            "Test Conversation".to_string(),
            "gpt-4".to_string(),
            None
        )
        .await?;

    // Create tags
    let tag_1 = tag_service.create_tag("ML", None).await?;
    let tag_2 = tag_service.create_tag("Research", None).await?;

    // Assert: Verify tags were created
    let tags = tag_service.get_all_tags().await?;
    assert_eq!(
        tags.len(),
        2,
        "Should have created 2 tags"
    );

    let tag_names: Vec<&str> = tags.iter().map(|t| t.name().as_ref()).collect();
    assert!(
        tag_names.contains(&"ML"),
        "Should contain ML tag"
    );
    assert!(
        tag_names.contains(&"Research"),
        "Should contain Research tag"
    );

    // Verify conversation exists
    let retrieved = conversation_service
        .get_conversation(conversation.id.as_str())
        .await?;

    assert!(
        retrieved.is_some(),
        "Should retrieve created conversation"
    );

    let conv = retrieved.unwrap();
    assert_eq!(
        conv.title(),
        "Test Conversation",
        "Conversation title should match"
    );

    // Verify tag deletion works
    tag_service.delete_tag(tag_1.id().as_str()).await?;

    let remaining_tags = tag_service.get_all_tags().await?;
    assert_eq!(
        remaining_tags.len(),
        1,
        "Should have 1 tag after deletion"
    );
    assert_eq!(
        remaining_tags[0].name().as_ref(),
        "Research",
        "Remaining tag should be Research"
    );

    Ok(())
}

