{
  "name": "lattice-desktop",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bash dev.sh",
    "build": "node build-auto.js",
    "build:auto": "node build-auto.js",
    "build:node": "node build.js",
    "build:win": "powershell -ExecutionPolicy Bypass -File build.ps1",
    "build:unix": "bash build.sh",
    "build:dev": "node build-auto.js --mode dev --no-bundle",
    "build:release": "node build-auto.js --mode release",
    "build:production": "node build-auto.js --mode production --clean --checksums",
    "build:clean": "node build-auto.js --clean",
    "build:fast": "node build-auto.js --mode dev --no-bundle --skip-tests",
    "build:master": "powershell -ExecutionPolicy Bypass -File build-master.ps1",
    "build:master:all": "powershell -ExecutionPolicy Bypass -File build-master.ps1 -Components all",
    "build:master:desktop": "powershell -ExecutionPolicy Bypass -File build-master.ps1 -Components sidecar,frontend,tauri",
    "build:master:backend": "powershell -ExecutionPolicy Bypass -File build-master.ps1 -Components backend",
    "build:master:sidecar": "powershell -ExecutionPolicy Bypass -File build-master.ps1 -Components sidecar",
    "build:complete": "powershell -ExecutionPolicy Bypass -File build-master.ps1 -Components all -Clean -Checksums",
    "build:all": "bash build.sh",
    "checksums": "bash build.sh --checksums",
    "bundle:python": "python scripts/bundle_python.py",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --config vitest.config.ts src/tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e-results/html",
    "bindings:generate": "cd src-tauri && cargo run --bin export_bindings",
    "bindings:check": "cd src-tauri && cargo run --bin export_bindings -- --check",
    "contracts:check": "node scripts/check-ipc-contracts.mjs --self-test",
    "contracts:sql": "python3 scripts/check-sql-contracts.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "~2.9.0",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-shell": "2.3.4",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-bubble-menu": "^3.20.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.24",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.553.0",
    "mammoth": "^1.11.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.2.0",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "^16.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tauri-apps/cli": "~2.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "picomatch": "4.0.5"
  }
}
