# Application Settings
APP_NAME=Vault
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ElectricSQL Configuration
ELECTRIC_URL=http://localhost:5133
ELECTRIC_DATABASE_URL=postgresql://electric:electric@localhost:5432/electric

# Embedding Model Configuration
EMBEDDING_MODEL=dunzhang/stella_en_1.5B_v5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
MODEL_CACHE_DIR=./models

# Image Embedding Configuration
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
IMAGE_EMBEDDING_DIMENSION=512

# File Watcher Configuration
WATCH_DIRECTORIES=["C:/Users/YourUser/Documents", "C:/Users/YourUser/Pictures"]
WATCH_RECURSIVE=True
WATCH_IGNORE_PATTERNS=[".git", "node_modules", "__pycache__", "*.tmp"]

# Search Configuration
SEARCH_TOP_K=10
SEARCH_SIMILARITY_THRESHOLD=0.7

# Background Tasks
BACKGROUND_TASK_WORKERS=4
TASK_QUEUE_SIZE=1000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=True

# File Processing
MAX_FILE_SIZE_MB=100
SUPPORTED_TEXT_EXTENSIONS=[".txt", ".md", ".pdf", ".docx", ".html", ".json"]
SUPPORTED_IMAGE_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"]

# Performance
VECTOR_INDEX_LISTS=100
VECTOR_INDEX_PROBES=10

# Security - CRITICAL: CHANGE THESE VALUES!
# Generate secure random keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: JWT_SECRET_KEY and JWT_REFRESH_SECRET_KEY MUST be different for security
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_FOR_ACCESS_TOKENS_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_SECURE_KEY_FOR_REFRESH_TOKENS_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Feature Flags
ENABLE_OCR=True
ENABLE_IMAGE_EMBEDDINGS=True
ENABLE_AUTO_SYNC=True

# OpenTelemetry Configuration
OTEL_ENABLED=false
OTEL_SERVICE_NAME=vault-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
ENVIRONMENT=development
